@startuml
' Phụ trách phần mới: Khởi (quan hệ lệnh), Tân (kho/dịch vụ), Kiệt (tiến độ), Lợi (hóa đơn).
title HiHiHaHa Auto - 8 bảng MySQL demo
entity users { * id : BIGINT
  --
  full_name : VARCHAR
  phone_number : VARCHAR <<unique>>
  password_hash : VARCHAR
  role : MANAGER/TECHNICIAN
}
entity customers { * id : BIGINT
  --
  full_name : VARCHAR
  phone_number : VARCHAR <<unique>>
  email : VARCHAR
}
entity vehicles { * id : BIGINT
  --
  customer_id : BIGINT
  license_plate : VARCHAR <<unique>>
  model : VARCHAR
}
entity parts { * id : BIGINT
  --
  part_code : VARCHAR <<unique>>
  part_name : VARCHAR
  unit : VARCHAR
  price : DECIMAL
  stock_quantity : INT
}
entity services { * id : BIGINT
  --
  service_code : VARCHAR <<unique>>
  service_name : VARCHAR
  labor_price : DECIMAL
  default_part_id : BIGINT (nullable)
  default_part_quantity : INT
}
entity work_orders { * id : BIGINT
  --
  order_code : VARCHAR <<unique>>
  vehicle_id : BIGINT
  created_by : BIGINT
  assigned_to : BIGINT
  status : ENUM
  assigned_at : TIMESTAMP
  finished_at : TIMESTAMP
  stock_deducted_at : TIMESTAMP
}
entity work_order_items { * id : BIGINT
  --
  work_order_id : BIGINT
  part_id : BIGINT (nullable)
  service_id : BIGINT (nullable)
  item_type : PART/LABOR
  progress_percent : 0/50/100
  quantity : INT
  unit_price : DECIMAL
}
entity invoices { * id : BIGINT
  --
  work_order_id : BIGINT <<unique>>
  amount : DECIMAL
  payment_status : ENUM
  reported_at : TIMESTAMP
  paid_at : TIMESTAMP
}
customers ||--o{ vehicles
vehicles ||--o{ work_orders
users ||--o{ work_orders : created_by
users |o--o{ work_orders : assigned_to
work_orders ||--o{ work_order_items
parts |o--o{ work_order_items
parts |o--o{ services : default_part
services |o--o{ work_order_items
work_orders ||--|| invoices
@enduml
