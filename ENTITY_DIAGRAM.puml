@startuml
' Phụ trách phần mới: Khởi. Sơ đồ khái niệm bốn luồng nghiệp vụ.
title HiHiHaHa Auto - Luồng nghiệp vụ
actor "Kỹ thuật viên\nkiêm tư vấn" as Tech
actor "Quản lý gara" as Manager
actor "Khách hàng" as Customer
rectangle "Next.js → Java Servlet → MySQL" {
  usecase "Tiếp nhận xe và tạo lệnh" as Create
  usecase "Chọn nhiều dịch vụ cho một xe" as Services
  usecase "Xem phụ tùng từ kho" as Parts
  usecase "Phân công và xem hiệu suất" as Assign
  usecase "Cập nhật tiến độ; trừ tồn khi xong" as Progress
  usecase "Checklist từng công việc" as Checklist
  usecase "Xác thực OTP và xem lệnh" as Otp
  usecase "Báo chuyển khoản VietQR" as Pay
  usecase "Đối soát thanh toán" as Verify
}
Tech --> Create
Tech --> Parts
Tech --> Services
Tech --> Progress
Tech --> Checklist
Manager --> Parts
Manager --> Services
Manager --> Assign
Manager --> Verify
Customer --> Otp
Customer --> Pay
@enduml
