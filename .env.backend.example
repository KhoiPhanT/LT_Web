# Khởi: MySQL demo; Lợi: OTP email. Sao chép thành .env.backend.local trên macOS/Linux.
# Docker Compose đọc file .env.backend.local trên cả Windows và macOS/Linux.
MYSQL_ROOT_PASSWORD='change-this-for-local-development'
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=8089
GMAIL_USER=
GMAIL_APP_PASSWORD=
# true exposes a generated OTP preview only for local classroom demo.
DEMO_MODE=true

# Tên project cố định để chạy lại đúng volume dữ liệu.
COMPOSE_PROJECT_NAME=ltweb-gara
